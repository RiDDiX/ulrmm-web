# copy to .env; quasar.config.js reads it at build and dev time

# API address baked into the production build and used by quasar dev
PROD_URL="https://api.example.com"
DEV_URL="https://api.example.com"
# address of the dashboard itself
APP_URL="https://app.example.com"

# quasar dev server
DEV_HOST=0.0.0.0
DEV_PORT=80
USE_HTTPS=false
